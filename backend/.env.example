PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=contacto@plotex.cl
EMAIL_PASS=tu_app_password
EMAIL_FROM="PLOTEX <contacto@plotex.cl>"
EMAIL_TO=ventas@plotex.cl
# Ademas de EMAIL_TO, cada cotizacion siempre envia una copia de respaldo
# fija a plotextemuco@gmail.com (definido en backend/src/utils/mailer.js).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Backend (usado para armar la returnUrl que Transbank llama tras el pago)
BACKEND_URL=http://localhost:3000

# Transbank Webpay Plus
# "integration" simula respuestas y no requiere credenciales reales.
# Para "production" completa el codigo de comercio y api key entregados por Transbank.
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

# Autenticacion de administracion (JWT con HttpOnly Cookie)
JWT_SECRET=super_secreto_jwt_cambiar_en_produccion
ADMIN_USER=admin
# Puedes definir ADMIN_PASSWORD en plano para desarrollo o ADMIN_PASSWORD_HASH con hash bcrypt
ADMIN_PASSWORD=admin123